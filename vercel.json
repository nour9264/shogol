{
    "rewrites": [
        {
            "source": "/api-proxy/(.*)",
            "destination": "https://shogol.runasp.net/api/$1"
        },
        {
            "source": "/notificationHub/(.*)",
            "destination": "https://shogol.runasp.net/notificationHub/$1"
        },
        {
            "source": "/chatHub/(.*)",
            "destination": "https://shogol.runasp.net/chatHub/$1"
        }
    ]
}